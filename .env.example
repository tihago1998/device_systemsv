# Copie este archivo como .env y cambie los valores. El archivo .env NO se sube a GitHub.

# Base de datos (SQLite en desarrollo)
DATABASE_URL=sqlite:///./device_systems.db

# JWT: genere una clave larga y aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambie-esta-clave-por-una-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS: orígenes de frontend autorizados, separados por coma (nunca "*" si se usan credenciales)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (true/false)
RATE_LIMIT_ENABLED=true
